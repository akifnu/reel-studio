REEL_PIPELINE_PATH=../DSprojects/reel-pipeline
# REELKIT_DATA=../DSprojects/reel-pipeline/data
STUDIO_ROOT=.studio
# Optional on loopback; required when binding to a network interface. Never commit a real key.
STUDIO_TOKEN=
STUDIO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
STUDIO_MAX_UPLOAD_BYTES=4294967296
# Optional OpenAI-compatible provider. Quick instructions work without a key.
OPENAI_API_KEY=
STUDIO_AI_URL=https://api.openai.com/v1
STUDIO_AI_MODEL=gpt-4.1-mini
